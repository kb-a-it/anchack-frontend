VITE_API_BASE_URL=
VITE_KAKAO_JS_KEY=
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 디자인 캡처용 Design Preview. true면 로그인·추천·관심 동네·리뷰 API를 Mock으로 대체하고
# 서버로 쓰기 요청을 보내지 않는다. 로컬 개발 서버와 Vercel Preview 배포에서만 동작하며,
# Vercel Production·일반 프로덕션 빌드에서는 true여도 항상 꺼진다(README "Design Preview 모드" 참고).
# 로컬에서는 .env.local에, Vercel에서는 Preview 환경 변수로만 설정할 것
VITE_DESIGN_MODE=false
