VITE_API_BASE_URL=
VITE_KAKAO_JS_KEY=
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 디자인 캡처용 Design Preview. true면 로그인·추천·관심 동네·리뷰 API를 Mock으로 대체하고
# 실제 백엔드로 요청을 보내지 않는다. 로컬 개발 서버와 Vercel Preview 배포에서 동작하며,
# Vercel Production은 feat/design-preview 브랜치 + VITE_DESIGN_MODE_ALLOW_PRODUCTION=true일 때만
# 켜진다. 그 외 프로덕션 빌드에서는 true여도 항상 꺼진다(README "Design Preview 모드" 참고).
VITE_DESIGN_MODE=false
# Vercel Production 임시 디자인 검토 배포에서만 true로 설정(로컬에서는 쓰지 않음)
VITE_DESIGN_MODE_ALLOW_PRODUCTION=false
